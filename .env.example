# Secrets only. Non-secret endpoints (SearXNG URL, browser backend/CDP URL,
# model IDs) live in harness.toml, not here.

# The OpenCode endpoint, serving both model roles (head and subagent).
# Every provider declared in harness.toml has its key resolved at load time,
# whether or not a role uses it — so declaring a second provider here means
# setting its key too.
OPENCODE_API_KEY=

# Signs cookies for the local SearXNG instance (searxng/docker-compose.yml reads it
# via `docker compose --env-file .env`). Generate: openssl rand -hex 32
SEARXNG_SECRET=
