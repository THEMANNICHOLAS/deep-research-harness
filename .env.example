# Secrets only. Non-secret endpoints (SearXNG URL, model IDs) live in
# harness.toml, not here.

# Smart-model orchestration (GLM 5.2 default, DeepSeek V4 Pro fallback)
OPENCODE_API_KEY=

# Worker-model triage (Cerebras free tier)
CEREBRAS_API_KEY=

# Signs cookies for the local SearXNG instance (searxng/docker-compose.yml reads it
# via `docker compose --env-file .env`). Generate: openssl rand -hex 32
SEARXNG_SECRET=
